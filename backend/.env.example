# --- Supabase (Project Settings -> Database / API) ---
# Pooled connection (Transaction pooler, port 6543) - used by the running app.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct connection (port 5432 / Session pooler) - used by prisma migrate.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
# Required only when creating transport administrator accounts from the admin UI.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

PORT=4000
# Still used to sign the short-lived Google Classroom OAuth state value.
JWT_SECRET="replace-this-with-a-random-secret-of-at-least-32-characters"
# Comma-free single origin of the deployed frontend, e.g. https://metsol.vercel.app
FRONTEND_URL="http://localhost:5173"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# --- Stripe fee payments (test mode only: sk_test_... or a restricted rk_test_... key) ---
# Dashboard -> Developers -> API keys. Prefer a restricted key with Checkout Sessions: write.
STRIPE_SECRET_KEY=""
# Dashboard -> Developers -> Webhooks, endpoint <backend URL>/api/payments/stripe/webhook,
# events: checkout.session.completed, .async_payment_succeeded, .async_payment_failed, .expired
STRIPE_WEBHOOK_SECRET=""
# Optional OSRM-compatible driving router base URL, e.g. https://router.project-osrm.org
OSRM_ROUTING_URL=""
# Optional Nominatim endpoint and identifying User-Agent for geocoding.
NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="MetsolUniversityTransport/1.0 (contact: admin@example.edu)"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/google/classroom/callback"
GOOGLE_OAUTH_ENCRYPTION_KEY="replace-this-with-a-random-secret-of-at-least-32-characters"
