generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  TRANSPORT_ADMIN
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  authId       String?  @unique
  role         Role     @default(STUDENT)
  studentId    String?  @unique
  department   String?
  batch        String?
  section      String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  courses                 CourseEnrollment[]
  assignments            Assignment[]
  submissions            Submission[]
  payments               Payment[]
  feeInvoices            FeeInvoice[]
  attendance             Attendance[]
  notices                Notice[]               @relation("NoticeAuthor")
  resultImports          ResultImport[]         @relation("ResultImportUploader")
  googleAccountConnection GoogleAccountConnection?
  transportActivities    TransportActivity[]    @relation("TransportActivityActor")
  uploadedTransportSchedules TransportSchedule[] @relation("TransportScheduleUploader")
  notifications          Notification[]
}

model GoogleAccountConnection {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  googleUserId           String
  email                  String
  accessTokenEncrypted   String
  refreshTokenEncrypted  String?
  tokenType              String    @default("Bearer")
  scope                  String?
  expiryDate             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                     String  @id @default(cuid())
  code                   String
  title                  String
  department             String?
  credits                Int     @default(3)
  teacherId              String?
  googleClassroomCourseId String?

  enrollments CourseEnrollment[]
  assignments Assignment[]
}

model CourseEnrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  semester String
  status   String @default("ENROLLED")

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId, semester])
}

model Assignment {
  id                          String    @id @default(cuid())
  title                       String
  description                 String?
  dueAt                       DateTime?
  courseId                    String
  teacherId                   String
  userId                      String?
  googleClassroomAssignmentId  String?
  googleClassroomCourseId     String?
  googleClassroomUrl          String?
  source                      String?   @default("PORTAL")
  materials                   Json?
  submissionStatus            String?

  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]
  user        User?        @relation(fields: [userId], references: [id])
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  submittedAt  DateTime @default(now())
  grade        Float?
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  studentId String
  amount    Decimal       @db.Decimal(10, 2)
  currency  String        @default("BDT")
  purpose   String
  status    PaymentStatus @default(PENDING)
  provider  String
  reference String?
  createdAt DateTime      @default(now())
  paidAt    DateTime?

  student User @relation(fields: [studentId], references: [id])
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  date      DateTime
  status    String

  student User @relation(fields: [studentId], references: [id])
}

model Notice {
  id                 String   @id @default(cuid())
  title              String
  body               String
  audience           String   @default("ALL")
  category           String   @default("GENERAL")
  createdAt          DateTime @default(now())
  authorId           String?
  transportScheduleId String?  @unique

  author             User?              @relation("NoticeAuthor", fields: [authorId], references: [id])
  transportSchedule  TransportSchedule? @relation(fields: [transportScheduleId], references: [id], onDelete: SetNull)
  notifications      Notification[]
}

model Result {
  id          String @id @default(cuid())
  studentId   String
  courseCode  String
  courseTitle String
  semester    String
  grade       String
  gradePoint  Float
  credits     Int
}

model ResultImport {
  id           String   @id @default(cuid())
  fileName     String
  fileHash     String   @unique
  uploadedById String
  uploadedAt   DateTime @default(now())
  recordCount  Int
  studentCount Int
  status       String   @default("IMPORTED")

  uploadedBy User               @relation("ResultImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  results    UniversityResult[]

  @@index([uploadedAt])
}

model UniversityResult {
  id                  String  @id @default(cuid())
  resultImportId      String
  studentId           String
  studentIdNormalized String
  studentName         String?
  courseCode          String?
  courseTitle         String?
  credits             Float
  marks               Float?
  grade               String
  gradePoint          Float
  semester            String?
  academicYear        String?
  gpa                 Float?
  cgpa                Float?

  resultImport ResultImport @relation(fields: [resultImportId], references: [id], onDelete: Cascade)

  @@index([resultImportId, studentIdNormalized])
}

model Resource {
  id         String  @id @default(cuid())
  title      String
  type       String
  url        String?
  subject    String?
  uploadedBy String?
}

model Question {
  id          String  @id @default(cuid())
  subject     String
  question    String
  options     Json?
  answer      String?
  explanation String?
}

model BusLocation {
  id        String   @id @default(cuid())
  busName   String
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt
}

model TransportRoute {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  startingPoint      String
  destination        String
  geometry           Json?
  geometrySource     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  buses              Bus[]
  stops              RouteStop[]

  @@index([updatedAt])
}

model Bus {
  id                       String   @id @default(cuid())
  name                     String
  number                   String   @unique
  routeId                  String?
  startingPoint            String
  destination              String
  estimatedDurationMinutes Int
  operatingDays            String[]
  morningSchedule          String?
  afternoonSchedule        String?
  returnSchedule           String?
  capacity                 Int?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  route                    TransportRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([isActive, updatedAt])
  @@index([routeId])
}

model BusStop {
  id          String   @id @default(cuid())
  name        String
  latitude    Float
  longitude   Float
  area        String
  osmId       String?
  description String?
  landmark    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routes      RouteStop[]

  @@index([name])
  @@index([area])
}

model RouteStop {
  id           String  @id @default(cuid())
  routeId      String
  busStopId    String
  sequence     Int
  arrivalTime  String?
  departureTime String?

  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  busStop      BusStop        @relation(fields: [busStopId], references: [id], onDelete: Restrict)

  @@unique([routeId, sequence])
  @@unique([routeId, busStopId])
  @@index([busStopId])
}

model TransportSchedule {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String   @default("application/pdf")
  fileSize     Int
  fileData     Bytes
  status       String   @default("DRAFT")
  uploadedById String
  createdAt    DateTime @default(now())
  publishedAt  DateTime?

  uploadedBy   User    @relation("TransportScheduleUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  notice       Notice?

  @@index([status, publishedAt])
  @@index([createdAt])
}

model TransportActivity {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  createdAt   DateTime @default(now())

  actor       User?    @relation("TransportActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  noticeId  String
  createdAt DateTime @default(now())
  readAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId, readAt, createdAt])
}

model FeeInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  studentId     String
  student       User      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  feeType       String
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("BDT")
  dueDate       DateTime?
  status        String    @default("UNPAID")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments PaymentAttempt[]
}

model PaymentAttempt {
  id                String    @id @default(uuid())
  reference         String    @unique
  invoiceId         String
  provider          String
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("BDT")
  status            String    @default("PENDING")
  providerPaymentId String?   @unique
  providerTrxId     String?   @unique
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([status])
}
